# =============================================================
# Supabase — requerido en produccion y desarrollo
# =============================================================
SUPABASE_URL=https://qwqjppzqrxqpbayqxawl.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sk_xxxx_reemplazar

# Opcional en desarrollo (necesario si usas el cliente anonimo)
SUPABASE_ANON_KEY=eyJxxxx_reemplazar

# =============================================================
# NextAuth v5 — AUTH_SECRET requerido en produccion
# =============================================================
AUTH_SECRET=generar_con_openssl_rand_base64_32
NEXTAUTH_URL=http://localhost:3000

# =============================================================
# Google OAuth 2.0 — opcional, solo si usas login con Google
# =============================================================
GOOGLE_CLIENT_ID=xxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxx

# =============================================================
# Google reCAPTCHA v3 — RECAPTCHA_REQUIRED=true exige token valido
# =============================================================
RECAPTCHA_SITE_KEY=6Lfxxxx
RECAPTCHA_SECRET_KEY=6Lfxxxx
RECAPTCHA_REQUIRED=false
